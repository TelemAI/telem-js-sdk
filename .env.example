# Copy to .env and fill in. Every value is optional: with none of them set the SDK
# talks to the hosted deployment anonymously, using ~/.telem/credentials.json if the
# guided installer has written one.

# Your API key. Also read from ~/.telem/credentials.json when this is unset.
TELEM_API_KEY=tlm_...

# Point at a staging or self-hosted deployment. Defaults to https://router.telem.ai
# TELEM_BASE_URL=https://router.telem.ai

# Client-wide search defaults.
# TELEM_TIER=extended                     # minimalist | default | extended | max
# TELEM_FIELDS=url,title,summary          # comma-separated; replaces TELEM_TIER
# TELEM_PROVIDERS_INCLUDE=exa,tavily      # comma-separated allow-list
# TELEM_PROVIDERS_EXCLUDE=serper          # comma-separated deny-list
# TELEM_FULL_CONTENT=1                    # exactly "1" turns whole-page content on

# Relocate ~/.telem. The value IS the directory.
# TELEM_CONFIG_DIR=/path/to/telem-config
