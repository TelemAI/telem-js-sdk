{
  "name": "@telemai/sdk",
  "version": "0.2.1",
  "description": "Telem web search and fetch for JavaScript and TypeScript.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vercel": {
      "import": {
        "types": "./dist/vercel/index.d.ts",
        "default": "./dist/vercel/index.js"
      },
      "require": {
        "types": "./dist/vercel/index.d.cts",
        "default": "./dist/vercel/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ai": "^6.0.277",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "ai": ">=5"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "vercel": [
        "./dist/vercel/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TelemAI/telem-js-sdk.git"
  },
  "homepage": "https://docs.telem.ai/sdks/javascript/",
  "bugs": {
    "url": "https://github.com/TelemAI/telem-js-sdk/issues"
  }
}
